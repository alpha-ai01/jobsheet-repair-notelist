rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isWorkspaceMember(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function getMembership(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isOwner(workspaceId) {
      return isWorkspaceMember(workspaceId) && getMembership(workspaceId).data.role == "owner";
    }

    function isOwnerOrManager(workspaceId) {
      return isWorkspaceMember(workspaceId) && (getMembership(workspaceId).data.role == "owner" || getMembership(workspaceId).data.role == "manager");
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /workspaces/{workspaceId} {
      allow read: if signedIn() && isWorkspaceMember(workspaceId);
      allow create: if signedIn() && emailVerified() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && isOwner(workspaceId);

      match /members/{uid} {
        allow read: if signedIn() && isWorkspaceMember(workspaceId);
        allow create: if signedIn() && emailVerified() && isOwnerOrManager(workspaceId);
        allow update: if signedIn() && isOwnerOrManager(workspaceId);
        allow delete: if signedIn() && isOwner(workspaceId);
      }

      match /repairs/{repairId} {
        allow read: if signedIn() && isWorkspaceMember(workspaceId);
        allow create: if signedIn() && emailVerified() && isWorkspaceMember(workspaceId);
        allow update: if signedIn() && isWorkspaceMember(workspaceId);
        allow delete: if signedIn() && isOwner(workspaceId);
      }
    }
  }
}
