rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getMemberData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function getRole(groupId) {
      return getMemberData(groupId).data.role;
    }

    function isSubscriptionActive(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.subscriptionStatus == 'active';
    }

    function isOwner(groupId) {
      return isSignedIn() && getRole(groupId) == 'owner';
    }

    function isManager(groupId) {
      return isSignedIn() && getRole(groupId) == 'manager';
    }

    function isMember(groupId) {
      return isSignedIn() && getRole(groupId) == 'member';
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && getMemberData(groupId) != null;
      allow write: if isOwner(groupId); // Only owner can manage group settings
      
      match /members/{uid} {
        allow read: if isSignedIn() && getMemberData(groupId) != null;
        allow create, update, delete: if isOwner(groupId) || (isManager(groupId) && request.resource.data.role == 'member');
      }

      match /jobsheets/{jobsheetId} {
        allow read: if isSignedIn() && getMemberData(groupId) != null && isSubscriptionActive(groupId);
        allow create, update: if isSignedIn() && getMemberData(groupId) != null && isSubscriptionActive(groupId) && (isOwner(groupId) || isManager(groupId) || isMember(groupId));
        allow delete: if isOwner(groupId);
      }
    }

    match /subscriptions/{groupId} {
      allow read: if isOwner(groupId);
      allow write: if false; // Backend only
    }

    match /memberships/{membershipId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow write: if false; // Backend only
    }
  }
}
