rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    
    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && isGroupMember(groupId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn() && isGroupMember(groupId);
        allow write: if signedIn() && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid;
      }

      match /jobsheets/{jobId} {
        allow read: if signedIn() && isGroupMember(groupId);
        allow create: if signedIn() && isGroupMember(groupId);
        allow update: if signedIn() && isGroupMember(groupId);
        allow delete: if false;
      }
    }
  }
}
