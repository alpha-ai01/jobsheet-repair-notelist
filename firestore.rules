rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isFinalStatus(status) {
      return status in ["done", "cancelled"];
    }

    function workspaceDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function memberDoc(workspaceId) {
      return get(
        /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)
      );
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && memberDoc(workspaceId).data.status == "active";
    }

    function workspaceRole(workspaceId) {
      return memberDoc(workspaceId).data.role;
    }

    function isOwner(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && workspaceRole(workspaceId) == "owner"
        && workspaceDoc(workspaceId).data.ownerUid == request.auth.uid;
    }

    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && workspaceRole(workspaceId) == "admin";
    }

    function isManager(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && workspaceRole(workspaceId) == "manager";
    }

    function isManagerUp(workspaceId) {
      return isOwner(workspaceId)
        || isWorkspaceAdmin(workspaceId)
        || isManager(workspaceId);
    }

    function isAdminUp(workspaceId) {
      return isOwner(workspaceId)
        || isWorkspaceAdmin(workspaceId);
    }

    function canManageExistingRole(workspaceId, existingRole) {
      return (
        isOwner(workspaceId)
        && existingRole in ["admin", "manager", "member"]
      ) || (
        isWorkspaceAdmin(workspaceId)
        && existingRole in ["manager", "member"]
      ) || (
        isManager(workspaceId)
        && existingRole == "member"
      );
    }

    function canAssignRole(workspaceId, newRole) {
      return (
        isOwner(workspaceId)
        && newRole in ["admin", "manager", "member"]
      ) || (
        isWorkspaceAdmin(workspaceId)
        && newRole in ["manager", "member"]
      ) || (
        isManager(workspaceId)
        && newRole == "member"
      );
    }

    function memberRepairUpdateAllowed(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && workspaceRole(workspaceId) == "member"
        && !isFinalStatus(resource.data.status)
        && request.time < resource.data.createdAt + duration.value(3, "h")
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.statusUpdatedBy == request.auth.uid
        && request.resource.data.statusUpdatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "customerName", "phone", "deviceModel", "imei",
          "issue", "customerNote", "price", "warrantyDays",
          "status", "statusNote", "statusUpdatedBy",
          "statusUpdatedByEmail", "statusUpdatedAt", "updatedAt"
        ]);
    }

    function managerRepairUpdateAllowed(workspaceId) {
      return isManagerUp(workspaceId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          request.resource.data.status == resource.data.status
          || (
            request.resource.data.statusUpdatedBy == request.auth.uid
            && request.resource.data.statusUpdatedAt == request.time
            && (
              !isFinalStatus(resource.data.status)
              || (
                request.resource.data.statusNote is string
                && request.resource.data.statusNote.size() > 0
              )
            )
          )
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "user"
        && request.resource.data.active == true;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "firstName", "lastName", "phone", "email",
          "emailVerified", "phoneVerified", "updatedAt"
        ]);

      allow delete: if false;
    }

    match /repairs/{document=**} {
      allow read, write: if false;
    }

    match /customers/{document=**} {
      allow read, write: if false;
    }

    match /references/{document=**} {
      allow read, write: if false;
    }

    match /analytics/{document=**} {
      allow read, write: if false;
    }

    match /admin/{document=**} {
      allow read, write: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.plan == "free"
        && request.resource.data.subscriptionStatus == "active"
        && request.resource.data.memberLimit == 1;

      allow update: if isOwner(workspaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.memberLimit == resource.data.memberLimit
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "status", "updatedAt"
        ]);

      allow delete: if false;

      match /members/{uid} {
        // Direct membership document access
          allow get: if signedIn()
            && (
              resource.data.uid == request.auth.uid
              || isWorkspaceMember(workspaceId)
            );

          // Collection-group discovery is restricted to the
          // authenticated user's own membership documents.
          allow list: if signedIn()
            && resource.data.uid == request.auth.uid;

        /*
         * Membership creation:
         *
         * 1) Workspace owner bootstrap.
         * 2) Authenticated recipient joining from an accepted invitation.
         */
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "active"
          && (
            (
              workspaceDoc(workspaceId).data.ownerUid == request.auth.uid
              && request.resource.data.role == "owner"
            )
            ||
            (
              request.resource.data.invitationId is string
              && request.resource.data.role in [
                "admin",
                "manager",
                "member"
              ]
              && get(
                /databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(request.resource.data.invitationId)
              ).data.status == "accepted"
              && get(
                /databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(request.resource.data.invitationId)
              ).data.respondedByUid == request.auth.uid
              && get(
                /databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(request.resource.data.invitationId)
              ).data.role == request.resource.data.role
              && request.auth.token.email != null
              && get(
                /databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(request.resource.data.invitationId)
              ).data.emailLower == request.auth.token.email.lower()
            )
          );

        allow update: if isManagerUp(workspaceId)
          && uid != request.auth.uid
          && resource.data.uid == uid
          && request.resource.data.uid == resource.data.uid
          && resource.data.role != "owner"
          && canManageExistingRole(workspaceId, resource.data.role)
          && canAssignRole(workspaceId, request.resource.data.role)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "role", "status", "updatedAt"
          ]);

        /*
         * Remove member:
         * Manager+ may remove only a lower role.
         * Nobody can remove themselves or the Owner.
         */
        allow delete: if isManagerUp(workspaceId)
          && uid != request.auth.uid
          && resource.data.role != "owner"
          && canManageExistingRole(
               workspaceId,
               resource.data.role
             );
      }

      match /repairs/{repairId} {
        allow read: if isWorkspaceMember(workspaceId);

        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == "waiting"
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if managerRepairUpdateAllowed(workspaceId)
          || memberRepairUpdateAllowed(workspaceId);

        allow delete: if isAdminUp(workspaceId);

        match /statusHistory/{historyId} {
          allow read: if isWorkspaceMember(workspaceId);

          allow create: if isWorkspaceMember(workspaceId)
            && request.resource.data.changedByUid == request.auth.uid
            && request.resource.data.changedAt == request.time
            && request.resource.data.toStatus ==
              getAfter(
                /databases/$(database)/documents/workspaces/$(workspaceId)/repairs/$(repairId)
              ).data.status;

          allow update, delete: if false;
        }
      }

      match /customers/{customerId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);

        allow update: if isManagerUp(workspaceId)
          || (
            isWorkspaceMember(workspaceId)
            && workspaceRole(workspaceId) == "member"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "customerName", "phone", "note", "lastJobId",
              "lastJobNumber", "updatedAt"
            ])
          );

        allow delete: if isAdminUp(workspaceId);
      }

      match /references/{referenceId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update: if isManagerUp(workspaceId);
        allow delete: if isAdminUp(workspaceId);
      }

      match /invitations/{inviteId} {

        /*
         * Workspace invitations
         *
         * Owner/Admin:
         * - create invitations
         * - read invitations inside their workspace
         * - cancel pending invitations
         *
         * Recipient:
         * - read only invitation matching authenticated email
         * - accept/decline only their own invitation
         *
         * Passwords are NEVER stored here.
         */

        allow get: if signedIn()
          && (
            isAdminUp(workspaceId)
            ||
            (
              request.auth.token.email != null
              && resource.data.emailLower ==
                 request.auth.token.email.lower()
            )
          );

        allow list: if signedIn()
          && (
            isAdminUp(workspaceId)
            ||
            (
              request.auth.token.email != null
              && resource.data.emailLower ==
                 request.auth.token.email.lower()
            )
          );

        allow create: if isAdminUp(workspaceId)
          && request.resource.data.invitedByUid ==
             request.auth.uid
          && request.resource.data.emailLower is string
          && request.resource.data.role in [
            "admin",
            "manager",
            "member"
          ]
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        /*
         * Owner/Admin can cancel.
         * Recipient can accept or decline only own invitation.
         */
        allow update: if signedIn()
          && request.resource.data.emailLower ==
             resource.data.emailLower
          && request.resource.data.invitedByUid ==
             resource.data.invitedByUid
          && request.resource.data.role ==
             resource.data.role
          && request.resource.data.createdAt ==
             resource.data.createdAt
          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "status",
               "respondedByUid",
               "respondedAt",
               "updatedAt"
             ])
          && request.resource.data.updatedAt == request.time
          && (
            (
              isAdminUp(workspaceId)
              && resource.data.status == "pending"
              && request.resource.data.status == "cancelled"
            )
            ||
            (
              request.auth.token.email != null
              && resource.data.emailLower ==
                 request.auth.token.email.lower()
              && resource.data.status == "pending"
              && request.resource.data.respondedByUid ==
                 request.auth.uid
              && request.resource.data.respondedAt ==
                 request.time
              && request.resource.data.status in [
                "accepted",
                "declined"
              ]
            )
          );

        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if isManagerUp(workspaceId);

        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    /*
     * Collection-group membership discovery.
     *
     * Required by:
     * collectionGroup(db, "members")
     * where("uid", "==", request.auth.uid)
     *
     * Query can only return membership documents
     * belonging to the authenticated user.
     */
    match /{path=**}/members/{uid} {
      allow list: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    /*
     * Collection-group invitation discovery.
     *
     * Query requirement:
     * collectionGroup(db, "invitations")
     * where("emailLower", "==", authenticated email)
     */
    match /{path=**}/invitations/{inviteId} {
      allow list: if signedIn()
        && request.auth.token.email != null
        && resource.data.emailLower ==
           request.auth.token.email.lower();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
